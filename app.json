{
  "expo": {
    "name": "My dividend",
    "slug": "my-dividend",
    "version": "1.0.0",
    "scheme": "mydividend",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#131E30"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mydividend.portfolio"
    },
    "android": {
      "package": "app.mydividend.portfolio",
      "versionCode": 9,
      "allowBackup": false,
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#131E30"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#131E30"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#131E30",
          "image": "./assets/splash-icon.png",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#131E30"
          },
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#10B981"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class com.facebook.hermes.** { *; }"
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ab139262-a8a9-4acb-86bf-e2e3ad1e6f29"
      }
    },
    "owner": "dia0"
  }
}
